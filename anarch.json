  "findingRules": {
    "layer-order-violation": {"reason": "the pipeline runs bottom up: foundations, the fact model, the MAP and REDUCE phases, the graph, the reviews of it, and the outputs, each reading only what is below it", "qualityAttribute": "maintainability"},
    "subsystem-order-violation": {"reason": "the subsystems follow the layers, so each can be tested with what lies below it", "qualityAttribute": "maintainability"},
    "interface-bypass": {"reason": "every package of a subsystem is its interface here, so this rule only guards against a new package left out of the model", "qualityAttribute": "maintainability"}
  },
  "fitness": {
    "requireAssigned": true,
    "calls": [
      {"name": "writes-through-atomicfs", "only": true,
       "from": ["github.com/StevenACoffman/codetospec/internal/atomicfs"],
       "callees": ["os.WriteFile", "os.Create", "os.OpenFile", "os.Rename", "os.RemoveAll"],
       "reason": "internal/atomicfs is the only writer of output, so an interrupted run never leaves a half-written file (AGENTS.md)", "qualityAttribute": "reliability"}
    ],
    "dependents": [
      {"name": "llm-only-in-phases", "packages": ["github.com/StevenACoffman/codetospec/internal/llm"],
       "onlyFrom": ["github.com/StevenACoffman/codetospec/internal/mapper", "github.com/StevenACoffman/codetospec/internal/reducer", "github.com/StevenACoffman/codetospec/internal/crosscheck", "github.com/StevenACoffman/codetospec/internal/quality", "github.com/StevenACoffman/codetospec/internal/acceptance", "github.com/StevenACoffman/codetospec/internal/ui", "github.com/StevenACoffman/codetospec/cmd/...", "github.com/StevenACoffman/codetospec/tools/..."],
       "reason": "only the phases that ask a model, and the commands that wire them, reach the LLM client; the deterministic checks never do", "qualityAttribute": "reliability"}
    ]
  }
